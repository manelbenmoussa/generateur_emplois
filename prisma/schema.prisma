generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          UserRole  @default(STUDENT)
  accounts      Account[]
  sessions      UserSession[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations to existing models - Auth-first approach
  teacher       Teacher?
  student       Student?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model UserSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model School {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  address         String?
  administrators  Administrator[]
  teachers        Teacher[]
  students        Student[]
  departments     Department[]
  rooms           Room[]
}

model Administrator {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String @map("password_hash")
  school       School @relation(fields: [schoolId], references: [id])
  schoolId     Int    @map("school_id")
}

model Department {
  id             Int             @id @default(autoincrement())
  name           String 
  school         School          @relation(fields: [schoolId], references: [id])
  schoolId       Int             @map("school_id")
  subjects       Subject[]
  specializations Specialization[]
  rooms          Room[]
}

model Subject {
  id              Int                     @id @default(autoincrement())
  name            String
  hourVolume      Decimal                 @map("hour_volume") @db.Decimal(3, 1)
  department      Department              @relation(fields: [departmentId], references: [id])
  departmentId    Int                     @map("department_id")
  sessions        Session[]
  teachers        TeacherSubject[]
}

model Teacher {
  id         Int              @id @default(autoincrement())
  lastName   String?          @map("last_name")
  firstName  String?          @map("first_name")
  school     School           @relation(fields: [schoolId], references: [id])
  schoolId   Int              @map("school_id")
  subjects   TeacherSubject[]
  
  // Link to User account
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String           @unique @map("user_id")
}

// Teacher "can teach" Subject (many-to-many)
model TeacherSubject {
  teacherId Int     @map("teacher_id")
  subjectId Int     @map("subject_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subject")
}

model Specialization {
  id           Int                     @id @default(autoincrement())
  name         String 
  department   Department              @relation(fields: [departmentId], references: [id])
  departmentId Int                     @map("department_id")
  groups       Group[]
}


model Group {
  id               Int             @id @default(autoincrement())
  level            String?
  specialization   Specialization  @relation(fields: [specializationId], references: [id])
  specializationId Int             @map("specialization_id")
  directSessions   Session[]
  students         Student[]

  @@map("groups")
}

model Session {
  id        Int            @id @default(autoincrement())
  subject   Subject        @relation(fields: [subjectId], references: [id])
  subjectId Int            @map("subject_id")
  group     Group          @relation(fields: [groupId], references: [id])
  groupId   Int            @map("group_id")

  @@map("sessions")
}

model Room {
  id           Int        @id @default(autoincrement())
  name         String?
  capacity     Int?
  school       School     @relation(fields: [schoolId], references: [id])
  schoolId     Int        @map("school_id")
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int        @map("department_id")

  @@map("rooms")
}

// Students are members of a Group and belong to a School
model Student {
  id         Int     @id @default(autoincrement())
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  school     School  @relation(fields: [schoolId], references: [id])
  schoolId   Int     @map("school_id")
  group      Group?  @relation(fields: [groupId], references: [id])
  groupId    Int?    @map("group_id")
  
  // Link to User account
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique @map("user_id")

  @@map("students")
}

